{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uaf.local/schemas/envelope-v1.json",
  "title": "UAF job/result envelope v1",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "iteration": {
          "default": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "attempt": {
          "default": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "activity": {
          "title": "Activity",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "secret_refs": {
          "items": {
            "type": "string"
          },
          "title": "Secret Refs",
          "type": "array"
        },
        "workspace": {
          "title": "Workspace",
          "type": "string"
        },
        "correlation_id": {
          "default": "",
          "title": "Correlation Id",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "activity",
        "workspace"
      ],
      "title": "JobEnvelope",
      "type": "object"
    },
    {
      "$defs": {
        "ArtifactRef": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "path": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Path",
              "type": "string"
            },
            "sha256": {
              "default": "",
              "title": "Sha256",
              "type": "string"
            },
            "bytes": {
              "default": 0,
              "title": "Bytes",
              "type": "integer"
            }
          },
          "required": [
            "name",
            "path"
          ],
          "title": "ArtifactRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "iteration": {
          "default": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "correlation_id": {
          "default": "",
          "title": "Correlation Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "done",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "outcome"
      ],
      "title": "ResultEnvelope",
      "type": "object"
    }
  ]
}
